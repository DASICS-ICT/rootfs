#!/bin/sh

CMD="dpdk-simpleperf"

# 测试参数
SIZES="16 32 64 128 256 512 1024 1460"
SECONDS=15
ITERATIONS=3
# ===========================================

echo "start test-pktsz.."
echo "test duration: ${SECONDS}s, each Size test iterations: ${ITERATIONS}"
echo "----------------------------------------------------------------------------------"
# Print header
printf "%-10s | %-15s | %-15s | %-15s | %-15s\n" "Size" "Run 1 (Mbps)" "Run 2 (Mbps)" "Run 3 (Mbps)" "Average (Mbps)"
echo "----------------------------------------------------------------------------------"

for size in $SIZES; do
    # initialize sum variable
    sum_bw=0
    
    r1=0
    r2=0
    r3=0

    for i in 1 2 3; do
        # run the command and capture output
        # notice: assuming dpdk-simpleperf outputs to stdout. If it outputs to stderr, add 2>&1
        output=$($CMD -- --size $size --seconds $SECONDS 2>&1)
        
        # use awk to extract the bandwidth value from the output
        # matching line: Bandwidth:     716.748 Mbps
        # $1 is Bandwidth:, $2 is the value, $3 is the unit
        bw=$(echo "$output" | awk '/Bandwidth:/ {print $2}')
        
        # if extraction fails (e.g., program error), default to 0
        if [ -z "$bw" ]; then
            bw=0
        fi

        # record individual run results
        if [ "$i" -eq 1 ]; then r1=$bw; fi
        if [ "$i" -eq 2 ]; then r2=$bw; fi
        if [ "$i" -eq 3 ]; then r3=$bw; fi

        # accumulate sum
        sum_bw=$(awk "BEGIN {print $sum_bw + $bw}")
    done

    # calculate average
    avg_bw=$(awk "BEGIN {print $sum_bw / $ITERATIONS}")

    # format and print the results for the current Size
    printf "%-10s | %-15s | %-15s | %-15s | %-15s\n" "$size" "$r1" "$r2" "$r3" "$avg_bw"
done

echo "----------------------------------------------------------------------------------"
echo "test-pktsz finished"