#!/bin/bash

# Mount file systems
mount -a
mdev -s

# Configure network
if [ -f /etc/init.d/setup-network.sh ]; then
    sh /etc/init.d/setup-network.sh
fi

# Set environment variables
export SHELL=/bin/bash

# Execute the customized script
if [ -f /etc/init.d/rc.local ]; then
    bash /etc/init.d/rc.local
fi

# Launch bash shell
exec bash