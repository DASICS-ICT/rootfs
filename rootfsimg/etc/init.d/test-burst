#!/bin/sh

CMD="dpdk-simpleperf"

# ===========================================
# Test Parameters
# ===========================================
SIZES="64 1460"
BURST_LIST="1 2 4 8 16 32 64 128"
SECONDS=15
ITERATIONS=5
# ===========================================

echo "Starting test-pktsz with burst size variation..."
echo "Test duration: ${SECONDS}s, Iterations per combo: ${ITERATIONS}"
echo "Result calculation: (Sum - Max - Min) / 3"
echo "----------------------------------------------------------------------------------"

# Initialize the final report variable with the header
# Changed second column to "Burst"
FINAL_REPORT=$(printf "%-6s | %-8s | %-10s | %-10s | %-10s | %-10s | %-10s | %-15s" "Size" "Burst" "Run 1" "Run 2" "Run 3" "Run 4" "Run 5" "Avg(No Min/Max)")

# Append separator line (sh compatible concatenation)
FINAL_REPORT="${FINAL_REPORT}
-----------------------------------------------------------------------------------------------------------------------------------"

# Outer loop: Packet Size
for size in $SIZES; do
    
    # Inner loop: Burst size
    for burst in $BURST_LIST; do
        
        # String to hold the raw bandwidth values for this combo
        raw_values=""

        echo ">> Testing Packet Size: $size | Burst: $burst"

        # Iteration loop (using while for sh compatibility)
        i=1
        while [ "$i" -le "$ITERATIONS" ]; do
            echo "   [Iteration $i/$ITERATIONS] Running..."
            
            # Run the command with size and burst parameters
            # 2>&1 | tee /dev/tty allows seeing output in real-time while capturing it
            run_output=$($CMD -- --size "$size" --burst "$burst" --seconds "$SECONDS" 2>&1 | tee /dev/tty)
            
            # Extract bandwidth using awk
            bw=$(echo "$run_output" | awk '/Bandwidth:/ {print $2}')
            
            # Default to 0 if extraction fails
            if [ -z "$bw" ]; then
                bw=0
            fi

            # Append value to list
            raw_values="$raw_values $bw"
            
            echo "   -> Result: $bw Mbps"
            echo "" 

            i=$((i+1))
        done

        # Calculate result for this row
        # We pass both size and burst to awk
        result_row=$(echo "$raw_values" | awk -v size="$size" -v burst="$burst" '
        {
            min = $1
            max = $1
            sum = 0
            
            for (i = 1; i <= NF; i++) {
                val = $i + 0
                sum += val
                if (val < min) min = val
                if (val > max) max = val
            }
            
            if (NF > 2) {
                avg = (sum - max - min) / (NF - 2)
            } else {
                avg = 0 
            }

            # Print formatted row including the Burst column
            printf "%-6s | %-8s | %-10s | %-10s | %-10s | %-10s | %-10s | %-15.3f", size, burst, $1, $2, $3, $4, $5, avg
        }')

        # Append row to final report
        FINAL_REPORT="${FINAL_REPORT}
${result_row}"

    done
done

# ===========================================
# Final Output Section
# ===========================================

echo ""
echo "==================================================================================================================================="
echo "                                            FINAL TEST REPORT                                                     "
echo "==================================================================================================================================="
echo "Parameters:"
echo "  Duration per run : ${SECONDS} seconds"
echo "  Iterations       : ${ITERATIONS}"
echo "  Calculation      : Average of middle 3 values (removing Min and Max)"
echo "-----------------------------------------------------------------------------------------------------------------------------------"
echo "$FINAL_REPORT"
echo "-----------------------------------------------------------------------------------------------------------------------------------"
echo "test-pktsz finished"