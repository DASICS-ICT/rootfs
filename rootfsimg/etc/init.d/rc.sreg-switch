#!/bin/sh

SREG_SUITE_BIN="/root/test_sreg_guard_suite"
SREG_LIST="s1"
SREG_CASES="viol_write proto_mismatch auth_tamper_bitflip"

echo "[SREG-SWITCH-TEST] START: sreg-switch-suite"

fail_count=0

if [ ! -x "$SREG_SUITE_BIN" ]; then
    echo "[SREG-SWITCH-TEST] MISSING: $SREG_SUITE_BIN"
    fail_count=$((fail_count + 1))
else
    ctrl_arg="-sreg-close"
    mode_label="OFF"

    for reg_name in $SREG_LIST; do
        for case_name in $SREG_CASES; do
            echo "[SREG-SWITCH-TEST] RUN[$mode_label]: $SREG_SUITE_BIN --reg $reg_name --case $case_name -dasics $ctrl_arg"
            case_out=$("$SREG_SUITE_BIN" --reg "$reg_name" --case "$case_name" -dasics "$ctrl_arg" 2>&1)
            case_rc=$?
            echo "$case_out" | grep -E "^\[SREG-GUARD\]|^\[DASICS SREG\]" || true

            if echo "$case_out" | grep -Eq "\\[DASICS SREG\\] (VIOL|PROTO|AUTH) fault"; then
                echo "[SREG-SWITCH-TEST] CASE FAIL[$mode_label]: $reg_name/$case_name unexpectedly raised SREG fault"
                echo "[SREG-SWITCH-TEST] CASE RAW LOG[$mode_label]: $reg_name/$case_name"
                echo "$case_out"
                fail_count=$((fail_count + 1))
            elif [ "$case_rc" -ne 0 ]; then
                echo "[SREG-SWITCH-TEST] CASE PASS[$mode_label]: $reg_name/$case_name attack succeeded (rc=$case_rc)"
            else
                echo "[SREG-SWITCH-TEST] CASE FAIL[$mode_label]: $reg_name/$case_name expected non-zero rc when guard is closed"
                echo "[SREG-SWITCH-TEST] CASE RAW LOG[$mode_label]: $reg_name/$case_name"
                echo "$case_out"
                fail_count=$((fail_count + 1))
            fi
        done
    done
fi

if [ "$fail_count" -eq 0 ]; then
    echo "[SREG-SWITCH-TEST] PASS"
else
    echo "[SREG-SWITCH-TEST] FAIL(total_fail=$fail_count)"
fi

exit 0
