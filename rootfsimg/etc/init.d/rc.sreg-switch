#!/bin/sh

SREG_SUITE_BIN="/root/test_sreg_guard_suite"
SREG_LIST="s1"
SREG_CASES="viol_write proto_mismatch auth_tamper_bitflip"
SREG_MODE="open"
DMESG_CLEAR_OK=0
FAULT_PAT="\\[DASICS SREG\\] (VIOL|PROTO|AUTH) fault|Raised a dasics 24 exception|fault reason: .*000000000000000[789]"

echo "[SREG-SWITCH-TEST] START: sreg-switch-suite"

fail_count=0

if [ ! -x "$SREG_SUITE_BIN" ]; then
    echo "[SREG-SWITCH-TEST] MISSING: $SREG_SUITE_BIN"
    fail_count=$((fail_count + 1))
else
    if grep -qw "dasics_sreg_mode=close" /proc/cmdline 2>/dev/null; then
        SREG_MODE="close"
    elif grep -qw "dasics_sreg_mode=open" /proc/cmdline 2>/dev/null; then
        SREG_MODE="open"
    fi

    ctrl_arg="-sreg-open"
    mode_label="ON"
    if [ "$SREG_MODE" = "close" ]; then
        ctrl_arg="-sreg-close"
        mode_label="OFF"
    fi

    echo "[SREG-SWITCH-TEST] MODE: $mode_label ($ctrl_arg)"

    if dmesg -c >/dev/null 2>&1; then
        DMESG_CLEAR_OK=1
    fi

    for reg_name in $SREG_LIST; do
        for case_name in $SREG_CASES; do
            if [ "$DMESG_CLEAR_OK" -eq 1 ]; then
                dmesg -c >/dev/null 2>&1 || true
            fi

            echo "[SREG-SWITCH-TEST] RUN[$mode_label]: $SREG_SUITE_BIN --reg $reg_name --case $case_name -dasics $ctrl_arg"
            case_out=$("$SREG_SUITE_BIN" --reg "$reg_name" --case "$case_name" -dasics "$ctrl_arg" 2>&1)
            case_rc=$?
            kmsg_out=""
            if [ "$DMESG_CLEAR_OK" -eq 1 ]; then
                kmsg_out=$(dmesg -c 2>/dev/null)
            fi
            echo "$case_out" | grep -E "^\[SREG-GUARD\]|^\[DASICS SREG\]" || true

            if [ "$SREG_MODE" = "close" ]; then
                if echo "$case_out" | grep -Eq "$FAULT_PAT" || \
                   echo "$kmsg_out" | grep -Eq "$FAULT_PAT"; then
                    echo "[SREG-SWITCH-TEST] CASE FAIL[$mode_label]: $reg_name/$case_name unexpectedly raised SREG fault"
                    echo "[SREG-SWITCH-TEST] CASE RAW LOG[$mode_label]: $reg_name/$case_name"
                    echo "$case_out"
                    echo "$kmsg_out" | tail -n 40
                    fail_count=$((fail_count + 1))
                elif [ "$case_rc" -ne 0 ]; then
                    echo "[SREG-SWITCH-TEST] CASE PASS[$mode_label]: $reg_name/$case_name attack succeeded (rc=$case_rc)"
                else
                    echo "[SREG-SWITCH-TEST] CASE FAIL[$mode_label]: $reg_name/$case_name expected non-zero rc when guard is closed"
                    echo "[SREG-SWITCH-TEST] CASE RAW LOG[$mode_label]: $reg_name/$case_name"
                    echo "$case_out"
                    fail_count=$((fail_count + 1))
                fi
            else
                if [ "$case_rc" -ne 0 ] && \
                   (echo "$case_out" | grep -Eq "$FAULT_PAT" || \
                    echo "$kmsg_out" | grep -Eq "$FAULT_PAT"); then
                    echo "[SREG-SWITCH-TEST] CASE PASS[$mode_label]: $reg_name/$case_name guard blocked attack"
                else
                    echo "[SREG-SWITCH-TEST] CASE FAIL[$mode_label]: $reg_name/$case_name missing guard-fault evidence under open mode (rc=$case_rc)"
                    echo "[SREG-SWITCH-TEST] CASE RAW LOG[$mode_label]: $reg_name/$case_name"
                    echo "$case_out"
                    echo "$kmsg_out" | tail -n 40
                    fail_count=$((fail_count + 1))
                fi
            fi
        done
    done
fi

if [ "$fail_count" -eq 0 ]; then
    echo "[SREG-SWITCH-TEST] PASS"
else
    echo "[SREG-SWITCH-TEST] FAIL(total_fail=$fail_count)"
fi

exit 0
