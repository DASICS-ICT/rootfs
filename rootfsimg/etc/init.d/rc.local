#!/bin/sh

# ================= test script path =================
#TEST_SCRIPT="/etc/init.d/test-mbuf"
# ===========================================

true

# config Hugepages
echo 256 > /sys/kernel/mm/hugepages/hugepages-2048kB/nr_hugepages
mkdir -p /dev/hugepages
mount -t hugetlbfs none /dev/hugepages

# config driver (IGB UIO)
# echo "0000:01:00.0" > /sys/bus/pci/drivers/igb/unbind
echo "8086 1521" > /sys/bus/pci/drivers/igb_uio/new_id

# create device node (added error suppression to prevent errors if the file already exists)
mknod /dev/uio1 c 252 1 2>/dev/null || true
mknod /dev/uio2 c 252 2 2>/dev/null || true
# run test script
# if [ -f "$TEST_SCRIPT" ]; then
#     echo "Running test script: $TEST_SCRIPT"
#     sh "$TEST_SCRIPT"
# else
#     echo "Error: Test script not found at $TEST_SCRIPT"
# fi