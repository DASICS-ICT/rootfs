#!/bin/sh

S0_SUITE_BIN="/root/test_s0_guard_suite"
S0_CASES="viol_write viol_read proto_mismatch legal_save_restore"

echo "[DASICS-TEST] START: s0-guard-tests only"

fail_count=0

echo "[DASICS-TEST] SUITE START: s0-guard-tests"
if [ ! -x "$S0_SUITE_BIN" ]; then
    echo "[DASICS-TEST] MISSING: $S0_SUITE_BIN"
    fail_count=$((fail_count + 1))
else
    for case_name in $S0_CASES; do
        echo "[DASICS-TEST] RUN: $S0_SUITE_BIN --case $case_name"
        case_out=$("$S0_SUITE_BIN" --case "$case_name" -dasics 2>&1)
        echo "$case_out" | grep -E "^\[S0-GUARD\]|^\[DASICS S0\]" || true

        case "$case_name" in
            viol_write|viol_read)
                expect_text="[DASICS S0] VIOL fault"
                ;;
            proto_mismatch)
                expect_text="[DASICS S0] PROTO fault"
                ;;
            legal_save_restore)
                expect_text="[S0-GUARD] RESULT: PASS (legal_save_restore)"
                ;;
            *)
                expect_text=""
                ;;
        esac

        if [ -n "$expect_text" ] && echo "$case_out" | grep -Fq "$expect_text"; then
            echo "[DASICS-TEST] CASE PASS: s0/$case_name"
        else
            echo "[DASICS-TEST] CASE FAIL: s0/$case_name missing expected text: $expect_text"
            echo "[DASICS-TEST] CASE RAW LOG: s0/$case_name"
            echo "$case_out"
            fail_count=$((fail_count + 1))
        fi
    done
fi

if [ "$fail_count" -eq 0 ]; then
    echo "[DASICS-TEST] PASS"
else
    echo "[DASICS-TEST] FAIL(total_fail=$fail_count)"
fi

exit 0
