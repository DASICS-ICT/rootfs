[submodule "busybox-1_32_stable"]
	path = apps/busybox/repo
	url = https://github.com/mirror/busybox.git
	branch = 1_32_stable
[submodule "gmp-6_2_1"]
	path = libs/gmp/repo
	url = https://github.com/DASICS-ICT/gmp.git
	ignore = all
[submodule "mpfr-4_2_1"]
	path = libs/mpfr/repo
	url = https://github.com/DASICS-ICT/mpfr.git
	branch = mpfr-4.2.1
	ignore = all
[submodule "binutils-gdb-14"]
	path = apps/binutils-gdb/repo
	url = https://sourceware.org/git/binutils-gdb.git
	branch = gdb-14-branch
	ignore = all
