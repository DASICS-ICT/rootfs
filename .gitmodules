[submodule "busybox-1_32_stable"]
	path = apps/busybox/repo
	url = https://github.com/mirror/busybox.git
	branch = 1_32_stable
[submodule "openssl-3_4_0"]
	path = libs/openssl/repo
	url = https://github.com/openssl/openssl.git
[submodule "zlib-1_3_1"]
	path = libs/zlib/repo
	url = https://github.com/madler/zlib.git
	ignore = all
[submodule "openssh-9_9_p1"]
	path = apps/openssh/repo
	url = https://github.com/openssh/openssh-portable.git
	ignore = all
