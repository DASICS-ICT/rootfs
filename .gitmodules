[submodule "busybox-1_32_stable"]
	path = apps/busybox/repo
	url = https://github.com/mirror/busybox.git
	branch = 1_32_stable
[submodule "apr-1.7.5"]
	path = libs/apr/repo
	url = https://github.com/apache/apr.git
	ignore = all
[submodule "libexpat-2.6.4"]
	path = libs/libexpat/repo
	url = https://github.com/libexpat/libexpat.git
[submodule "apr-util-1.7.x"]
	path = libs/apr-util/repo
	url = https://github.com/apache/apr-util.git
	branch = 1.7.x
	ignore = all
[submodule "openssl-3_4_0"]
	path = libs/openssl/repo
	url = https://github.com/openssl/openssl.git
