[submodule "busybox-1_32_stable"]
	path = apps/busybox/repo
	url = https://github.com/mirror/busybox.git
	branch = 1_32_stable
[submodule "libs/LibDASICS/repo"]
	path = libs/LibDASICS/repo
	url = https://github.com/DASICS-ICT/LibDASICS
[submodule "spdk"]
	path = apps/spdk/repo
	url = https://github.com/DASICS-ICT/spdk.git
[submodule "libfuse"]
	path = libs/libfuse/repo
	url = https://github.com/libfuse/libfuse.git
[submodule "openssl-3_4_0"]
	path = libs/openssl/repo
	url = https://github.com/openssl/openssl.git
[submodule "cunit"]
	path = libs/cunit/repo
	url = https://github.com/jacklicn/CUnit.git
[submodule "libnuma"]
	path = libs/libnuma/repo
	url = https://github.com/numactl/numactl.git
